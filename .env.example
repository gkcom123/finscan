# ---- Which LLM: "openai" or "azure" ----
FINSCAN_LLM_PROVIDER=openai
LLM_TEMPERATURE=0

# ---- OpenAI (used when FINSCAN_LLM_PROVIDER=openai) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4                    # needs function calling + a long context
# OPENAI_BASE_URL=                      # only for a proxy or compatible endpoint

# ---- Azure OpenAI (used when FINSCAN_LLM_PROVIDER=azure) ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o          # deployment name, not model name

# ---- TLS (local dev behind an SSL-inspecting corporate proxy ONLY) ----
# FINSCAN_INSECURE_SSL=true

# ---- Service: API + MCP server (finscan-api) ----
FINSCAN_API_KEY=change-me                # required: callers send it as header x-api-key
# FINSCAN_LINK_SECRET=                   # signs upload/download links (default: the API key)
# FINSCAN_ROOT=                          # folder holding inbox/, mappings/, _work/ (default: found from cwd)
FINSCAN_RUNNER=local                     # local (a process here) | azure (Container Apps Job)
FINSCAN_PUBLIC_URL=http://localhost:8000 # base URL used in links handed to users
# FINSCAN_ALLOWED_HOSTS=                 # MCP host check, e.g. myapp.azurecontainerapps.io (empty: off)
# FINSCAN_LINK_MINUTES=30
# FINSCAN_MAX_UPLOAD_MB=200

# ---- Azure Container Apps Job (FINSCAN_RUNNER=azure) ----
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=
# AZURE_JOB_NAME=finscan-job
# AZURE_JOB_IMAGE=                      # optional: default is the Job's own image
# AZURE_CLIENT_ID=                       # the user-assigned managed identity's client id
