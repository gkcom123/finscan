# ---- Which LLM: "openai" or "azure" ----
FINSCAN_LLM_PROVIDER=openai
LLM_TEMPERATURE=0

# ---- OpenAI (used when FINSCAN_LLM_PROVIDER=openai) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o                     # needs function calling + a long context
# OPENAI_BASE_URL=                      # only for a proxy or compatible endpoint

# ---- Azure OpenAI (used when FINSCAN_LLM_PROVIDER=azure) ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o          # deployment name, not model name

# ---- Extraction behaviour ----
FINSCAN_OCR_FALLBACK=true               # run OCR when a page yields no text layer
FINSCAN_MAX_PDF_CHARS=120000            # truncation guard for the LLM prompt
FINSCAN_FUZZY_THRESHOLD=86              # 0-100; below this the LLM resolves the row match
FINSCAN_TOLERANCE_PCT=1.0               # arithmetic cross-check tolerance, percent
FINSCAN_MIN_CONFIDENCE=0.60             # rows below this are flagged, not written silently

# ---- Company layout profiles ----
FINSCAN_PROFILE_STORE=./profiles        # one editable JSON file per company
FINSCAN_REQUIRE_CONFIRMATION=true       # hold a new/drifted layout for one human sign-off

# ---- API ----
FINSCAN_API_KEY=change-me               # required in x-api-key header by Copilot Studio
FINSCAN_WORK_DIR=./_work

# ---- CLI company runs (input/<company>/*.pdf + model → input/<company>_output.*) ----
FINSCAN_INPUT_DIR=./input

# ---- Local Copilot demo (read PDF + model from test/<company>/) ----
FINSCAN_TEST_DIR=./test
FINSCAN_DEMO_ENABLED=true
